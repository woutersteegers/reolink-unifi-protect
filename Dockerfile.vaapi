# VAAPI-enabled unifi-cam-proxy for the Steegers house.
#
# Hardware: UGREEN NAS, Intel Core i5-1235U (Iris Xe iGPU), Unraid 7.2.3,
# /dev/dri/renderD128 exposed. Upstream's published image is Alpine 3.10 with
# an ffmpeg that has VAAPI encoders compiled in but NO Intel driver, so VAAPI
# cannot initialize there. This image builds on Ubuntu 24.04 (glibc) with the
# Intel iHD media driver, so the Reolink Elite Floodlight's H.265 main stream
# can be hardware-transcoded to H.264 (decode + encode both on the iGPU) for
# UniFi Protect, using the --hw-transcode flags added to unifi/cams/reolink.py.
#
# Build (on the NAS, where the iGPU is):
#   docker build -f Dockerfile.vaapi -t unifi-cam-proxy:vaapi .
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LIBVA_DRIVER_NAME=iHD \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python3-pip \
        build-essential git pkg-config ca-certificates \
        libjpeg-dev zlib1g-dev \
        ffmpeg netcat-openbsd \
        intel-media-va-driver-non-free libva2 libva-drm2 vainfo \
        libvpl2 libmfxgen1 \
    && rm -rf /var/lib/apt/lists/*

# Isolated venv avoids Ubuntu's PEP 668 "externally-managed" pip restriction.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
COPY requirements.txt .
RUN pip install -U pip wheel setuptools maturin \
    && pip install -r requirements.txt

COPY . .
RUN pip install .

COPY ./docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["unifi-cam-proxy"]
