# Copy to `.env` ON THE NAS (next to docker-compose.yml) and fill in.
# The real .env holds secrets (camera password, adoption token) and is
# gitignored — it must never be committed.

# UniFi Protect NVR (the UDM/gateway) IP, optionally with :port
NVR_IP=192.168.1.1

# 60-MINUTE adoption token from Protect. Generate right before `up`:
#   https://<NVR_IP>/proxy/protect/api/cameras/manage-payload   (must be logged in)
# Only needed for the first adoption; after the camera is adopted the cert
# identity persists and a stale token here is harmless.
ADOPTION_TOKEN=replace-me

# The Reolink camera
CAM_IP=192.168.1.129
CAM_USER=admin
CAM_PASS=replace-me
CAM_NAME=Floodlight

# A unique locally-administered MAC for this emulated camera (one per camera).
CAM_MAC=AABBCC00C129

# Transcode: scale the 5120x1552 H.265 main down to this width (aspect kept)
# so Protect accepts it, then encode H.264 at this bitrate. Start conservative;
# once adoption is confirmed you can raise the width (e.g. 3840) or set 0 for
# the camera's native 5120 width.
TRANSCODE_WIDTH=2560
TRANSCODE_BITRATE=6M
