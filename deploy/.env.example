# Copy to deploy/.env (gitignored — never commit the real file) and fill in.
# These feed deploy/docker-compose.yml.

# UniFi Protect NVR (UDM/UNVR) IP
NVR_IP=192.168.1.1

# Adoption token: log in to Protect, then copy "token" from
#   https://<NVR_IP>/proxy/protect/api/cameras/manage-payload
# Tokens expire after ~60 minutes and are effectively single-use —
# fetch a fresh one right before (re-)adopting.
ADOPTION_TOKEN=

# MAC address for the virtual camera (any locally-administered MAC works;
# changing it makes Protect see a brand-new camera)
CAM_MAC=AA:BB:CC:00:11:22

# The Reolink camera
CAM_IP=192.168.1.129
CAM_USER=admin
CAM_PASS=

# Display name in Protect
CAM_NAME=Floodlight
